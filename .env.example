AUDITRAIL_RUNS_DIR=/Users/chen/agentloop/runs
BACKEND_HOST=0.0.0.0
BACKEND_PORT=18080
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 设为 0/false 时不读取本文件。仅供测试隔离使用：tests/conftest.py 会强制设置它，
# 因此开发者本地 .env 无法影响测试，也不会把凭据带进测试进程。
# 生产运行时不要关闭，否则必须改用真实环境变量提供全部配置。
# AUDITRAIL_LOAD_DOTENV=1

MODEL_PROVIDER=openai
MODEL_NAME=gpt-4.1
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
CHECKPOINTER_TYPE=memory

# 本地 DSH Headless 执行默认关闭；启用时 binary、profile 和 workspace 都由服务端固定/白名单控制。
DSH_RUNTIME_ENABLED=false
# DSH_BINARY=/absolute/path/to/dsh
# DSH_ALLOWED_PROFILES=headless
# DSH_ALLOWED_WORKSPACE_ROOTS=/absolute/path/to/workspaces
# DSH_DEFAULT_TIMEOUT_SECONDS=300
# DSH_MAX_TIMEOUT_SECONDS=900
# DSH_MAX_CONCURRENCY=1

# DSH 裁判默认关闭；必须显式指定与 evaluand 不同的专用 profile 和 workspace。
# DSH_JUDGE_PROFILE=agentloop-judge
# DSH_JUDGE_WORKSPACE=/absolute/path/to/workspaces/judge

# ACP 交互运行时（长驻 `dsh --profile acp`）。仍需 DSH_RUNTIME_ENABLED=true 与上面同一套
# binary/profile/workspace 白名单；此处只是单独开关。profile 固定为 acp，调用方不能传 argv。
# DSH_ACP_ENABLED=true

# 可选的真实 DSH 集成冒烟测试（默认整个模块 skip，不进入全量 pytest）。
# 它需要真实 dsh 二进制、会消耗模型额度，并默认在 pytest 临时目录里派生一个隔离
# DSH home，因此不会改动你的 ~/.dsh。详见 docs/dsh-operations.md。
# AUDITRAIL_DSH_INTEGRATION=1
# AUDITRAIL_DSH_INTEGRATION_PROFILE=headless
# AUDITRAIL_DSH_INTEGRATION_ACP_PROFILE=acp
# AUDITRAIL_DSH_INTEGRATION_WORKSPACE=/absolute/path/to/workspace
# AUDITRAIL_DSH_INTEGRATION_HOME=/absolute/path/to/isolated-dsh-home
# AUDITRAIL_DSH_INTEGRATION_TIMEOUT=300

# 前端默认同源请求，由 Vite dev server 代理 /api 到后端，任意端口都不会跨域。
# 仅在需要让浏览器直连远程后端时才设置 VITE_API_BASE_URL，并把它加进上面的 CORS_ORIGINS。
# VITE_API_BASE_URL=http://localhost:18080
# 代理目标（可选，默认用 BACKEND_PORT）：
# VITE_API_TARGET=http://localhost:18080
# 前端端口（可选，默认 5173，start.sh 可用 FRONTEND_PORT 覆盖）：
# FRONTEND_PORT=5173


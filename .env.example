AUDITRAIL_RUNS_DIR=/Users/chen/agentloop/runs
BACKEND_HOST=0.0.0.0
BACKEND_PORT=18080
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 设为 0/false 时不读取本文件。仅供测试隔离使用：tests/conftest.py 会强制设置它，
# 因此开发者本地 .env 无法影响测试，也不会把凭据带进测试进程。
# 生产运行时不要关闭，否则必须改用真实环境变量提供全部配置。
# AUDITRAIL_LOAD_DOTENV=1

MODEL_PROVIDER=openai
MODEL_NAME=gpt-4.1
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
CHECKPOINTER_TYPE=memory

# 本地 DSH Headless 执行默认关闭；启用时 binary、profile 和 workspace 都由服务端固定/白名单控制。
DSH_RUNTIME_ENABLED=false
# DSH_BINARY=/absolute/path/to/dsh
# DSH_ALLOWED_PROFILES=headless
# DSH_ALLOWED_WORKSPACE_ROOTS=/absolute/path/to/workspaces
# DSH_DEFAULT_TIMEOUT_SECONDS=300
# DSH_MAX_TIMEOUT_SECONDS=900
# DSH_MAX_CONCURRENCY=1

# DSH 裁判默认关闭；必须显式指定与 evaluand 不同的专用 profile 和 workspace。
# DSH_JUDGE_PROFILE=agentloop-judge
# DSH_JUDGE_WORKSPACE=/absolute/path/to/workspaces/judge

# ACP 交互运行时（长驻 `dsh --profile acp`）默认关闭，需显式设为 true 才启用。
# 它仍叠在 master 开关之上：即使这里设为 true，也必须同时满足 DSH_RUNTIME_ENABLED=true
# 与上面同一套 binary/profile/workspace 白名单，单一开关无法打开 ACP。
# 只打开 DSH_RUNTIME_ENABLED 不会隐式启用 ACP。profile 固定为 acp，调用方不能传 argv。
# DSH_ACP_ENABLED=true

# 可选的真实 DSH 集成冒烟测试（默认整个模块 skip，不进入全量 pytest）。
# 它需要真实 dsh 二进制、会消耗模型额度，并默认在 pytest 临时目录里派生一个隔离
# DSH home，因此不会改动你的 ~/.dsh。详见 docs/dsh-operations.md。
# AUDITRAIL_DSH_INTEGRATION=1
# AUDITRAIL_DSH_INTEGRATION_PROFILE=headless
# AUDITRAIL_DSH_INTEGRATION_ACP_PROFILE=acp
# AUDITRAIL_DSH_INTEGRATION_WORKSPACE=/absolute/path/to/workspace
# AUDITRAIL_DSH_INTEGRATION_HOME=/absolute/path/to/isolated-dsh-home
# AUDITRAIL_DSH_INTEGRATION_TIMEOUT=300

# 前端默认同源请求，由 Vite dev server 代理 /api 到后端，任意端口都不会跨域。
# 仅在需要让浏览器直连远程后端时才设置 VITE_API_BASE_URL，并把它加进上面的 CORS_ORIGINS。
# VITE_API_BASE_URL=http://localhost:18080
# 代理目标（可选，默认用 BACKEND_PORT）：
# VITE_API_TARGET=http://localhost:18080
# 前端端口（可选，默认 5173，start.sh 可用 FRONTEND_PORT 覆盖）：
# FRONTEND_PORT=5173


# --- Agent 测试平台（Phase 0 单次运行切片）---------------------------------
# Agent/TestCase 配置与幂等键存放目录（JSON 文件，不引入数据库）。
# AUDITRAIL_PLATFORM_DIR=/Users/chen/agentloop/platform
# Agent endpoint SSRF 策略：默认只允许 80/443 端口的公网地址；内网/loopback
# 地址必须显式加入 AGENT_ALLOWED_HOSTS 或打开 AGENT_ALLOW_PRIVATE_ENDPOINTS。
# AGENT_ALLOWED_HOSTS=192.168.1.238,agent.internal.example
# AGENT_ALLOWED_PORTS=80,443,8788
# AGENT_ALLOW_PRIVATE_ENDPOINTS=false

# --- Phase 3：外部集成与平台运营 --------------------------------------------
# 本地管理开关（价格表管理、run-index 管理端点；false 时管理 API 返回 403）。
# AUDITRAIL_LOCAL_ADMIN=true
# Run Index 受控轮询刷新（默认关闭；本环境无 watchdog 依赖，实现为 polling）。
# AUDITRAIL_RUN_INDEX_WATCHER=false
# AUDITRAIL_RUN_INDEX_DEBOUNCE_MS=500
# AUDITRAIL_RUN_INDEX_MAX_BATCH=1000
# AUDITRAIL_RUN_INDEX_POLL_INTERVAL_MS=2000
# Langfuse HTTP 导入（默认关闭）：token 只从环境变量读取，绝不写入配置/日志。
# LANGFUSE_SECRET_KEY=sk-lf-...

# --- Phase 4：生产化增强与平台治理 ------------------------------------------
# 本地权限边界（非生产级认证）：local=单一本地身份（默认 admin 角色）；
# disabled=全部放行，仅适用于本地开发，API/前端会明确标注。
# AUDITRAIL_AUTH_MODE=local
# AUDITRAIL_AUTH_ROLE=admin
# AUDITRAIL_AUTH_ACTOR=local-admin
# ImportJob 后台 worker（进程内、文件持久化；支持断点续导/取消/重试）。
# AUDITRAIL_IMPORT_WORKER=true
# AUDITRAIL_IMPORT_LEASE_SECONDS=60
# AUDITRAIL_IMPORT_CHECKPOINT_RECORDS=100
# AUDITRAIL_IMPORT_MAX_RETRIES=5

# --- Phase 5：生产部署、正式认证与可靠任务基础设施 ---------------------------
# 部署形态/存储/队列/认证模式（详见 docs/phase5-production-architecture.md）。
# 非法组合（如 production+disabled、local_worker+file）会在启动时拒绝。
# AUDITRAIL_DEPLOYMENT_MODE=local          # local|single_process|production
# AUDITRAIL_STORAGE_MODE=file              # file|database|dual
# AUDITRAIL_QUEUE_MODE=inline              # inline|local_worker|redis
# 数据库：sqlite 内嵌（默认，单机跨进程安全）或 PostgreSQL（生产，可选依赖 psycopg）。
# AUDITRAIL_DATABASE_URL=sqlite:////abs/path/platform/auditrail.db
# AUDITRAIL_DATABASE_URL=postgresql://auditrail:***@db:5432/auditrail?sslmode=require
# AUDITRAIL_REDIS_URL=rediss://...
# 认证：disabled 仅限本地开发（production 下拒绝启动）。
# AUDITRAIL_AUTH_MODE=local                # disabled|local|oidc|jwt
# AUDITRAIL_AUTH_REQUIRED=true
# AUDITRAIL_OIDC_ISSUER_URL=https://idp.example.com
# AUDITRAIL_OIDC_CLIENT_ID=auditrail
# AUDITRAIL_OIDC_CLIENT_SECRET=
# AUDITRAIL_OIDC_AUDIENCE=auditrail
# AUDITRAIL_OIDC_SCOPES=openid,profile,email
# AUDITRAIL_OIDC_REDIRECT_URI=
# AUDITRAIL_OIDC_JWKS_CACHE_SECONDS=3600
# AUDITRAIL_OIDC_JWKS_MAX_STALE_SECONDS=86400
# AUDITRAIL_OIDC_CLOCK_SKEW_SECONDS=60
# AUDITRAIL_OIDC_ROLES_CLAIM=roles
# AUDITRAIL_JWT_SECRET=
# AUDITRAIL_TENANT_ID=default
# 跨进程 worker 调优与备份目录。
# AUDITRAIL_WORKER_POLL_INTERVAL_MS=1000
# AUDITRAIL_WORKER_HEARTBEAT_SECONDS=15
# AUDITRAIL_BACKUP_DIR=

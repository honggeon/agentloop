AUDITRAIL_RUNS_DIR=/Users/chen/agentloop/runs
BACKEND_HOST=0.0.0.0
BACKEND_PORT=18080
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

MODEL_PROVIDER=openai
MODEL_NAME=gpt-4.1
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
CHECKPOINTER_TYPE=memory

# 本地 DSH Headless 执行默认关闭；启用时 binary、profile 和 workspace 都由服务端固定/白名单控制。
DSH_RUNTIME_ENABLED=false
# DSH_BINARY=/absolute/path/to/dsh
# DSH_ALLOWED_PROFILES=headless
# DSH_ALLOWED_WORKSPACE_ROOTS=/absolute/path/to/workspaces
# DSH_DEFAULT_TIMEOUT_SECONDS=300
# DSH_MAX_TIMEOUT_SECONDS=900
# DSH_MAX_CONCURRENCY=1

# 前端默认同源请求，由 Vite dev server 代理 /api 到后端，任意端口都不会跨域。
# 仅在需要让浏览器直连远程后端时才设置 VITE_API_BASE_URL，并把它加进上面的 CORS_ORIGINS。
# VITE_API_BASE_URL=http://localhost:18080
# 代理目标（可选，默认用 BACKEND_PORT）：
# VITE_API_TARGET=http://localhost:18080
# 前端端口（可选，默认 5173，start.sh 可用 FRONTEND_PORT 覆盖）：
# FRONTEND_PORT=5173

